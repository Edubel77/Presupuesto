rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Validation Blueprints ---
    function isValidBudgetConfig(data, userId) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'monthlyBudget',
          'onboardingCompleted',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'monthlyBudget',
          'onboardingCompleted',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 80
        && data.monthlyBudget is number
        && data.monthlyBudget >= 0
        && data.monthlyBudget <= 100000000
        && data.onboardingCompleted is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMovement(data, userId) {
      return data.keys().hasAll([
          'uid',
          'type',
          'day',
          'dateISO',
          'dateLabel',
          'description',
          'category',
          'amount',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'type',
          'day',
          'dateISO',
          'dateLabel',
          'description',
          'category',
          'amount',
          'paymentMethod',
          'notes',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.type is string
        && (data.type == 'expense' || data.type == 'income')
        && data.day is number
        && data.day >= 1
        && data.day <= 31
        && data.dateISO is string
        && data.dateISO.size() == 10
        && data.dateISO.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.dateLabel is string
        && data.dateLabel.size() >= 1
        && data.dateLabel.size() <= 40
        && data.description is string
        && data.description.size() >= 1
        && data.description.size() <= 160
        && data.category is string
        && data.category.size() >= 1
        && data.category.size() <= 60
        && data.amount is number
        && data.amount > 0
        && data.amount <= 100000000
        && (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() >= 1 && data.paymentMethod.size() <= 40))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection Rules ---
    match /users/{userId}/budget/{configId} {
      allow get: if isOwner(userId) && isValidId(configId) && configId == 'config';
      allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;

      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidId(configId)
        && configId == 'config'
        && isValidBudgetConfig(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidId(configId)
        && configId == 'config'
        && isValidBudgetConfig(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['monthlyBudget', 'onboardingCompleted', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['monthlyBudget', 'displayName', 'onboardingCompleted', 'updatedAt'])
        );

      allow delete: if false;
    }

    match /users/{userId}/movements/{movementId} {
      allow get: if isOwner(userId) && isValidId(movementId);
      allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;

      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidId(movementId)
        && isValidMovement(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidId(movementId)
        && isValidMovement(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().type == existing().type
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'day',
          'dateISO',
          'dateLabel',
          'description',
          'category',
          'amount',
          'paymentMethod',
          'notes',
          'updatedAt'
        ]);

      allow delete: if isOwner(userId) && isValidId(movementId);
    }
  }
}
